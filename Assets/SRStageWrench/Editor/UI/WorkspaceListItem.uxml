<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/SRStageWrench/Editor/UI/listItem.uss?fileID=7433441132597879392&amp;guid=96a8597f73a37404b937a50c4a3923ee&amp;type=3#listItem"/>
    <ui:VisualElement name="spaceListItem" class="listItem" style="flex-direction: row; flex-grow: 1; justify-content: space-around; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
        <ui:VisualElement name="row" focusable="true" style="justify-content: center; flex-grow: 1;">
            <ui:VisualElement name="Top" style="flex-basis: 65%; flex-direction: row; width: initial;">
                <ui:IMGUIContainer name="icon" style="width: 13%; height: 50%; justify-content: space-between; align-items: flex-start; top: 25%; bottom: 25%; background-image: resource(&quot;containerIcon&quot;); -unity-background-scale-mode: scale-to-fit;"/>
                <ui:Label text="Workspace" display-tooltip-when-elided="true" name="spaceName" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 18%; -unity-text-align: middle-left; margin-left: 5px; height: auto; visibility: visible; margin-right: 5px; width: auto; -unity-font: resource(&quot;Rubik-Regular&quot;); align-items: flex-start; flex-wrap: wrap; justify-content: space-between; min-width: initial; min-height: initial; max-width: 88%; overflow: hidden; white-space: normal;"/>
            </ui:VisualElement>
            <ui:VisualElement name="tags" style="flex-direction: row; display: flex; align-items: center; justify-content: flex-start; border-top-color: rgba(0, 0, 0, 0.12); border-top-width: 1.5px; flex-grow: 1; padding-left: 10px;">
                <ui:Label text="NORMAL" display-tooltip-when-elided="true" name="normMETA" style="display: flex; flex-direction: row; flex-shrink: 1; flex-grow: 0; flex-wrap: wrap; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 9px; flex-basis: auto; -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-font-style: normal; width: initial; padding-right: 5px; padding-left: 5px; border-left-color: rgb(171, 106, 255); border-right-color: rgb(171, 106, 255); border-top-color: rgb(171, 106, 255); border-bottom-color: rgb(171, 106, 255); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; color: rgb(171, 106, 255); height: auto; margin-right: 1.5px;"/>
                <ui:Label text="SPIN" display-tooltip-when-elided="true" name="spinMETA" style="display: flex; flex-direction: row; flex-shrink: 1; flex-grow: 0; flex-wrap: wrap; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 9px; flex-basis: auto; -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-font-style: normal; height: auto; width: initial; max-width: initial; padding-right: 5px; padding-left: 5px; border-left-color: rgb(253, 61, 176); border-right-color: rgb(253, 61, 176); border-top-color: rgb(253, 61, 176); border-bottom-color: rgb(253, 61, 176); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; color: rgb(253, 61, 176); max-height: initial; margin-left: 1.5px; margin-right: 1.5px;"/>
                <ui:Label text="EXP" display-tooltip-when-elided="true" name="expMETA" style="display: flex; flex-direction: row; flex-shrink: 1; flex-grow: 0; flex-wrap: wrap; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 9px; flex-basis: auto; -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-font-style: normal; height: initial; width: initial; max-width: initial; padding-right: 5px; padding-left: 5px; border-left-color: rgb(41, 124, 248); border-right-color: rgb(41, 124, 248); border-top-color: rgb(41, 124, 248); border-bottom-color: rgb(41, 124, 248); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; color: rgb(41, 124, 248); margin-left: 1.5px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
