        <ui:VisualElement name="deleteWarning" style="position: relative; flex-grow: 1; justify-content: center; width: auto; height: auto; background-color: rgb(46, 46, 46); display: none; border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-top-left-radius: 3px; border-bottom-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-left-color: rgb(255, 0, 46); border-right-color: rgb(255, 0, 46); border-top-color: rgb(255, 0, 46); border-bottom-color: rgb(255, 0, 46);">
            <ui:Label text="Are you sure you want to delete this Workspace?" display-tooltip-when-elided="true" name="deletetitle" style="-unity-text-align: upper-center; font-size: 25px; flex-wrap: nowrap; -unity-font-style: bold; justify-content: space-around; flex-shrink: 1; flex-grow: 1; -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); position: absolute; left: 0; align-items: center; right: 0; top: 100px;"/>
            <ui:Label text="Deleting a Workspace removes the workspace from the list.&#10;&#10;&#10;&lt;b&gt;&lt;size=150%&gt;WARNING!&lt;/b&gt;&lt;/size&gt;&#10;Checking the box below will PERMANENTELY DELETE all files/folders in the workspaces folder and CANNOT BE RECOVERED!" display-tooltip-when-elided="true" name="deleteDescription" style="align-items: center; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); font-size: 18px; color: rgb(192, 192, 192); -unity-text-align: upper-center; white-space: normal; padding-left: 100px; padding-right: 100px; margin-left: 90px; margin-right: 90px;"/>
            <ui:Toggle label="Delete Workspace Files as well" name="deleteFilesToggle" style="flex-direction: row-reverse; overflow: visible; justify-content: space-around; width: auto; align-items: stretch; position: absolute; left: 35%; bottom: 68px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); font-size: 18px; -unity-font-style: normal; -unity-text-align: middle-left; white-space: normal;"/>
            <ui:VisualElement name="buttons" label="Normal Stage" style="flex-direction: row; justify-content: space-around; flex-grow: 1; flex-shrink: 0; position: absolute; bottom: 0; left: 0; right: 0; height: 50px;">
                <ui:Button text="Delete" display-tooltip-when-elided="false" name="confirmDel" class="deleteButton" style="position: absolute; bottom: 0; right: 0; flex-shrink: 1; justify-content: space-between; width: 40%; flex-grow: 1; height: 50%; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                <ui:Button text="Cancel" display-tooltip-when-elided="true" name="cancelDel" binding-path="spinStageName" value="spinStageName" class="normButton" style="position: absolute; bottom: 0; right: auto; flex-shrink: 1; justify-content: flex-start; width: 45%; left: 0; height: 50%; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
