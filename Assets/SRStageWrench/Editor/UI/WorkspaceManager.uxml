<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/SRStageWrench/Editor/UI/Workspace.uss?fileID=7433441132597879392&amp;guid=1f3fa551d82e2104f9400199a686fa27&amp;type=3#Workspace"/>
    <ui:VisualElement name="root" class="root" style="flex-grow: 1;">
        <ui:VisualElement name="spaceList" class="spaceList" style="padding-left: 0; padding-right: 0; padding-top: 0; flex-grow: 1; min-width: initial; max-width: initial; width: 100px; display: flex;">
            <ui:VisualElement name="topBar" style="height: 46px; flex-direction: row; align-items: center; background-color: rgb(34, 34, 34); justify-content: space-between; left: 0;">
                <ui:Label text="Workspaces" display-tooltip-when-elided="true" name="title" style="flex-wrap: wrap; font-size: 25px; flex-direction: row-reverse; align-items: stretch; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); margin-left: 5px; letter-spacing: -5px; left: 0;"/>
                <ui:Button text="+" name="newSpace" tooltip="Create a New Workspace." style="flex-basis: auto; font-size: 20px; -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-font-definition: resource(&quot;Rubik-Regular&quot;); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; padding-top: 1px; padding-bottom: 1px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; overflow: visible; right: 2%;"/>
            </ui:VisualElement>
            <ui:ScrollView name="spaceList" class="listView" style="flex-shrink: 1; flex-grow: 1; display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="spaceContainer" class="spaceContainer" style="background-color: rgb(34, 34, 34); border-left-width: 0; padding-bottom: 0; padding-right: 0; flex-grow: 1; max-width: initial; max-height: initial; width: 600px; display: flex;">
            <ui:VisualElement name="top" style="background-color: rgb(34, 34, 34); flex-direction: row; height: 10%; margin-top: 15px; margin-left: 15px; justify-content: space-between; align-items: stretch;">
                <ui:VisualElement name="info" style="flex-direction: row; flex-grow: 1; align-items: flex-start; justify-content: flex-start;">
                    <ui:VisualElement name="Icon" tooltip="Ooooo look! it&apos;s a cool little Cube icon! oh and you found this little message! you see nothhiiinnnnggggg......" style="background-image: resource(&quot;containerIcon&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: space-around; flex-direction: row; align-items: stretch; margin-right: 1px; flex-grow: initial; flex-shrink: 1; width: 40px; height: 40px; left: auto; -unity-background-image-tint-color: rgb(130, 32, 250);"/>
                    <ui:VisualElement name="infoWrap" style="justify-content: space-between; align-items: stretch; min-width: auto; min-height: auto; padding-left: 10px;">
                        <ui:Label text="My Workspace" display-tooltip-when-elided="true" name="WorkspaceName" binding-path="workspaceName" tooltip="The Workspace&apos;s Name" style="font-size: 24px; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-font-style: bold; margin-left: 0; flex-direction: column; flex-shrink: 1; flex-grow: 1; flex-basis: auto;"/>
                        <ui:Label text="Author" display-tooltip-when-elided="true" name="WorkspaceName" binding-path="workspaceCreator" tooltip="The Workspaces Creator" style="font-size: 14px; -unity-font-definition: resource(&quot;Rubik-VariableFont_wght&quot;); -unity-font: resource(&quot;Rubik-VariableFont_wght&quot;); -unity-font-style: bold; margin-left: 0; flex-direction: column; flex-shrink: 1; flex-grow: 1; -unity-text-align: middle-left; flex-basis: auto; color: rgb(137, 137, 137);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="activeIndicator" tooltip="This is the Active Workspace" style="flex-direction: row; justify-content: flex-start; align-items: stretch; background-image: resource(&quot;CurrentWorkspaceIndicator&quot;); -unity-background-scale-mode: scale-to-fit; flex-grow: 0; width: 8px; height: 8px; -unity-background-image-tint-color: rgb(61, 234, 130); top: 8px; display: none;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Buttons" style="flex-direction: row; align-items: center; justify-content: space-around; margin-right: 15px;">
                    <ui:Button text="Set as active" display-tooltip-when-elided="true" name="switchtoSpace" tooltip="Set this Workspace as Active." class="normButton" style="height: 40%; -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); font-size: 14px;"/>
                    <ui:Button text="Clone" display-tooltip-when-elided="true" name="cloneSpace" tooltip="Clone this Workspace and all files associated with it." class="normButton" style="height: 40%; -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); font-size: 14px; display: flex;"/>
                    <ui:Button text="Merge" display-tooltip-when-elided="true" name="mergeSpaces" tooltip="Merge a different Workspace into this one. (You cannot undo this Later!)" class="normButton" style="height: 40%; -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); font-size: 14px;"/>
                    <ui:Button text="Delete" display-tooltip-when-elided="true" name="deleteSpace" tooltip="Delete this Workspace. " class="deleteButton" style="-unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); font-size: 14px; height: 40%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <uie:Toolbar name="optionTabs" style="border-bottom-width: 0; border-top-width: 1px; min-width: auto; min-height: auto; height: auto; justify-content: flex-start; flex-direction: row; flex-shrink: 1; border-right-width: 1px; border-left-width: 1px; width: auto; margin-left: 0; flex-wrap: nowrap; flex-grow: 0; background-color: rgb(34, 34, 34); border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); display: flex;">
                <uie:ToolbarButton text="Info" display-tooltip-when-elided="true" name="metaData" tooltip="The Workspace&apos;s Info" class="Tab" style="-unity-font: resource(&quot;Ubuntu-Regular&quot;); -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); padding-left: 8px; padding-right: 10px; padding-top: 4px; -unity-text-align: middle-left; margin-right: 3px;"/>
                <uie:ToolbarButton text="Normal(Linear)" display-tooltip-when-elided="true" focusable="true" name="normData" tooltip="Normal Stage Options" class="Tab" style="font-size: 15px; -unity-font: resource(&quot;Ubuntu-Regular&quot;); background-color: rgb(56, 56, 56); margin-left: 3px; margin-right: 3px; -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-text-align: middle-left; padding-left: 10px; padding-right: 10px; padding-bottom: 4px; padding-top: 4px;"/>
                <uie:ToolbarButton text="Spin Mode" display-tooltip-when-elided="true" name="spinData" tooltip="Spin Stage options" class="Tab" style="font-size: 15px; left: auto; border-top-left-radius: 5px; border-top-right-radius: 5px; margin-left: 3px; margin-right: 3px; background-color: rgb(56, 56, 56); -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); -unity-text-align: middle-left; padding-top: 4px; padding-bottom: 4px; padding-left: 10px; padding-right: 10px;"/>
                <uie:ToolbarButton text="Experience" display-tooltip-when-elided="true" name="expData" tooltip="Experience Stage Options" class="Tab" style="font-size: 15px; align-items: stretch; justify-content: flex-start; left: auto; margin-left: 3px; margin-right: 3px; border-top-left-radius: 5px; border-top-right-radius: 5px; background-color: rgb(56, 56, 56); -unity-font-definition: resource(&quot;Ubuntu-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); -unity-text-align: middle-left; padding-top: 4px; padding-bottom: 4px; padding-left: 8px; padding-right: 8px;"/>
            </uie:Toolbar>
            <ui:VisualElement name="selectSpaceInfo" style="justify-content: space-between; align-items: stretch; flex-grow: 1; flex-shrink: 1; background-color: rgb(56, 56, 56);">
                <ui:VisualElement name="workspaceMeta" style="background-color: rgb(56, 56, 56); display: flex; padding-top: 16px; padding-left: 20px; padding-right: 20px; justify-content: flex-start; align-items: stretch; flex-grow: 1; width: initial;">
                    <ui:TextField picking-mode="Ignore" label="Workspace Name" binding-path="workspaceName" name="workingName" tooltip="The Workspace&apos;s Name (This is only used in the Workspace screen and not shown in game)" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 14px; overflow: visible; -unity-font: resource(&quot;Rubik-Regular&quot;); padding-top: 10px; padding-bottom: 10px; flex-shrink: 1; justify-content: space-between; align-items: center;"/>
                    <ui:TextField picking-mode="Ignore" label="Creator" binding-path="workspaceCreator" name="workingAuthor" tooltip="The Workspace&apos;s Author/Creator (This is only used in the Workspace screen and not shown in game)" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 14px; -unity-text-align: middle-left; overflow: hidden; -unity-font: resource(&quot;Rubik-Regular&quot;); padding-top: 10px; padding-bottom: 10px;"/>
                    <ui:TextField picking-mode="Ignore" label="Working Directory" readonly="true" binding-path="workspacePath" name="workingDIR" focusable="false" tooltip="The Directory where the current Workspace&apos;s files reside" value="(Missing Directory!) Oh boy it seems i lost everything..." style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 14px; -unity-text-align: middle-left; overflow: hidden; padding-top: 10px; padding-bottom: 10px; -unity-font: resource(&quot;Rubik-Regular&quot;);"/>
                    <ui:TextField picking-mode="Ignore" label="Created at" readonly="true" binding-path="dateCreated" name="createdTime" focusable="false" tooltip="Timestamp of when the Workspace was created (in YYYYMMD-HHMMSS)" value="(No Time Set) Apparently it appeared out of thin air?" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); font-size: 14px; -unity-text-align: middle-left; overflow: hidden; padding-top: 10px; padding-bottom: 10px; -unity-font: resource(&quot;Rubik-Regular&quot;);"/>
                    <uie:ObjectField label="Custom Stage Info" name="csInfoObject" type="UnityEngine.GameObject, UnityEngine.CoreModule" focusable="false" binding-path="workspaceStageInfo" tooltip="The CustomStageInfo prefab for this Workspace. it stores all info about your stage(s) so when the game tries to load your stage(s), it knows what to load" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); font-size: 14px; padding-top: 10px; padding-bottom: 10px; -unity-text-align: middle-left;">
                        <ui:Button text="Create" display-tooltip-when-elided="true" name="createCSInfo" class="normButton" style="display: none;"/>
                    </uie:ObjectField>
                    <ui:VisualElement name="scenesArea" style="padding-top: 10px;">
                        <ui:Foldout text="Scenes" name="Scenes" tooltip="Scenes allow you to Visualize and edit your different Stage Types. " style="font-size: 14px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-top-left-radius: 3px; border-bottom-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px;">
                            <uie:ObjectField label="Normal Stage Scene" type="UnityEditor.SceneAsset, UnityEditor" name="normSceneField" binding-path="normStageScene" style="padding-top: 10px; padding-bottom: 10px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);">
                                <ui:Button text="Create" display-tooltip-when-elided="true" name="createScene" tooltip="Creates a New Scene for this Stage Type." class="normButton" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                                <ui:Button text="Set active" display-tooltip-when-elided="true" name="SwitchScene" tooltip="Set this Scene as the active Scene." class="normButton" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                                <ui:Button text="Delete" display-tooltip-when-elided="true" name="delScene" tooltip="Deletes this Scene. (This only deletes the Scene file and not the Prefabs attatched to it)" class="deleteButton" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                            </uie:ObjectField>
                            <uie:ObjectField label="Spin Stage Scene" type="UnityEditor.SceneAsset, UnityEditor" name="spinSceneField" binding-path="spinStageScene" style="padding-top: 10px; padding-bottom: 10px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);">
                                <ui:Button text="Create" display-tooltip-when-elided="true" name="createScene" tooltip="Creates a New Scene for this Stage Type." class="normButton"/>
                                <ui:Button text="Set active" display-tooltip-when-elided="true" name="SwitchScene" tooltip="Set this Scene as the active Scene." class="normButton"/>
                                <ui:Button text="Delete" display-tooltip-when-elided="true" name="delScene" tooltip="Deletes this Scene. (This only deletes the Scene file and not the Prefabs attatched to it)" class="deleteButton"/>
                            </uie:ObjectField>
                            <uie:ObjectField label="Experience Stage Scene" type="UnityEditor.SceneAsset, UnityEditor" name="expSceneField" binding-path="expStageScene" style="padding-top: 10px; padding-bottom: 10px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);">
                                <ui:Button text="Create" display-tooltip-when-elided="true" name="createScene" tooltip="Creates a New Scene for this Stage Type." class="normButton" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                                <ui:Button text="Set active" display-tooltip-when-elided="true" name="SwitchScene" tooltip="Set this Scene as the active Scene." class="normButton" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                                <ui:Button text="Delete" display-tooltip-when-elided="true" name="delScene" tooltip="Deletes this Scene. (This only deletes the Scene file and not the Prefabs attatched to it)" class="deleteButton" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                            </uie:ObjectField>
                        </ui:Foldout>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="normStageMeta" class="normStageMeta" style="display: none; flex-direction: row; justify-content: space-around;">
                    <ui:IMGUIContainer name="normIcon" tooltip="The Stage&apos;s Icon that will show in the Stage Selection Screen" style="flex-shrink: 0; flex-basis: 26%; height: 50%; background-image: resource(&quot;CustomStages&quot;);">
                        <uie:ObjectField name="textureRef" type="UnityEngine.Texture2D, UnityEngine.CoreModule" binding-path="normStageIcon" tooltip="Change the Stage&apos;s Icon" allow-scene-objects="false" style="justify-content: flex-start; font-size: 14px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); margin-left: 0; margin-right: 0; align-self: auto; align-content: auto; align-items: stretch; -unity-text-align: upper-center; bottom: -100%;"/>
                    </ui:IMGUIContainer>
                    <ui:VisualElement name="info" style="height: 50%; flex-grow: 1;">
                        <ui:TextField picking-mode="Ignore" name="stageName" binding-path="normStageName" value="StageName" tooltip="The Stage&apos;s Name (Shown in game as: &quot;StageName BY StageAuthor&quot;)" max-length="32"/>
                        <ui:TextField picking-mode="Ignore" name="stageAuthor" binding-path="normStageAuthor" value="Andromeda" label="Created By:" tooltip="The Stage&apos;s Author/Creator (Shows in game as &quot;StageName By StageCreator&quot;)" max-length="32" style="-unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); font-size: 16px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="objectFields" style="left: 0; right: 0; position: absolute; overflow: visible; justify-content: space-around; flex-grow: 0; height: 180px; top: auto; bottom: 0; min-width: initial;">
                        <uie:ObjectField label="Tile 1" name="tile01" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="normTile01" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Tile 2" name="tile02" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="normTile02" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Tile 3" name="tile03" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="normTile03" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Platform" name="normPlat" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="normplatform" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="SpecialFX" name="specialFX" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="normSpecialFX" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Skybox" name="normSkybox" type="UnityEngine.Material, UnityEngine.CoreModule" binding-path="normSkybox" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="spinStageMeta" class="spinStageMeta" style="display: none; justify-content: space-around;">
                    <ui:IMGUIContainer name="spinIcon" tooltip="The Stage&apos;s Icon that will show in the Stage Selection Screen" style="background-image: resource(&quot;CustomStages&quot;); height: 50%; flex-shrink: 0; flex-basis: 26%;">
                        <uie:ObjectField name="textureRef" type="UnityEngine.Texture2D, UnityEngine.CoreModule" binding-path="spinStageIcon" tooltip="Change the Stage&apos;s Icon" style="font-size: 14px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); margin-left: 0; margin-right: 0; bottom: -100%; align-content: auto; -unity-text-align: upper-center;"/>
                    </ui:IMGUIContainer>
                    <ui:VisualElement name="info" style="height: 50%; flex-grow: 1;">
                        <ui:TextField picking-mode="Ignore" name="stageName" binding-path="spinStageName" value="StageName" tooltip="The Stage&apos;s Name (Shown in game as: &quot;StageName BY StageAuthor&quot;)" max-length="32" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <ui:TextField picking-mode="Ignore" name="stageAuthor" binding-path="spinStageAuthor" value="Andromeda" label="Created By:" tooltip="The Stage&apos;s Author/Creator (Shows in game as &quot;StageName By StageCreator&quot;)" max-length="32" style="-unity-text-align: middle-left; font-size: 16px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="objectFields" style="left: 0; right: 0; position: absolute; overflow: visible; justify-content: space-around; flex-grow: 0; height: 180px; top: auto; bottom: 0; min-width: initial;">
                        <uie:ObjectField label="Spin Emitter" name="spinEmitter" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="spinEmitter" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Platform" name="spinPlat" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="spinPlatform" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="SpecialFX" name="specialFX" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="spinSpecialFX" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Skybox" name="spinSkybox" type="UnityEngine.Material, UnityEngine.CoreModule" binding-path="spinSkybox" allow-scene-objects="false" class="normalObjectView" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="expMeta" style="flex-grow: 1; flex-direction: column; margin-top: 5px; display: none;">
                    <ui:IMGUIContainer name="expBanner" tooltip="The Banner that will show when the &quot;Experience Available&quot; screen shows up" style="background-image: resource(&quot;Custom_Experience_Generic_Header&quot;); width: 100%; height: initial; justify-content: space-around; flex-direction: row; flex-basis: 150px;">
                        <uie:ObjectField type="UnityEngine.Texture2D, UnityEngine.CoreModule" binding-path="expPromptBanner" name="textureRef" tooltip="Change the Experience Banner" style="align-items: flex-end; justify-content: flex-end; width: 150px; margin-left: 0; margin-right: 0; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); right: 0; position: absolute; bottom: 0; margin-bottom: 0; margin-top: 0;"/>
                    </ui:IMGUIContainer>
                    <ui:TextField picking-mode="Ignore" value="CoolExperience" name="expName" binding-path="expName" tooltip="The Experiences Name (Shown in game on the Experience prompt as: &quot;ExpName BY ExpAuthor&quot;)" max-length="32" style="justify-content: center; overflow: hidden; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                    <ui:TextField picking-mode="Ignore" value="CoolExperience" name="expAuthor" binding-path="expAuthor" tooltip="The Experiences Author/Creator (Shown in game on the Experience prompt as: &quot;ExpName BY ExpAuthor&quot;)" max-length="32" style="justify-content: center; font-size: 16px; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;);"/>
                    <ui:VisualElement name="objectFields" style="left: 0; right: 0; position: relative; overflow: hidden; justify-content: space-around; flex-grow: 0; height: 180px; top: auto; bottom: 0; min-width: initial;">
                        <ui:TextField picking-mode="Ignore" label="Experience Tag                       EXP-" name="expTag" multiline="false" max-length="12" binding-path="expTag" tooltip="An Experience Tag is a 16 Letter/Number combination that links a Beatmap to the Experience. &quot;EXP-&quot; is already added for you.(BOTH the Beatmap AND Experience must have the EXACT matching EXP tag for them to be linked!)" is-delayed="false" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-text-align: middle-left;">
                            <ui:Label text="0/12" display-tooltip-when-elided="true" name="charCount" style="position: absolute; top: 7px; left: auto; right: 10px; justify-content: center; align-items: center; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Ubuntu-Regular&quot;); -unity-text-align: middle-left; white-space: nowrap;"/>
                        </ui:TextField>
                        <ui:TextField picking-mode="Ignore" label="Experience Prompt Text" value="This is a Default Message for an Experience" name="expDescription" multiline="true" max-length="150" binding-path="expPromptText" tooltip="A Custom Message that will show when the Experience Prompt is show to the player and can be used to warn and inform the player of the experience. (Has a Character Limit of 150)" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-text-align: middle-left; flex-wrap: wrap; white-space: normal;"/>
                        <uie:ObjectField label="Timeline" name="timeline" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="expPrefab" allow-scene-objects="false" class="normalObjectView" style="overflow: visible; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Timeline Object" name="timelineOBJ" type="UnityEngine.GameObject, UnityEngine.CoreModule" allow-scene-objects="false" class="normalObjectView" style="overflow: visible; display: none; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="SpecialFX" name="expspecialFX" type="UnityEngine.GameObject, UnityEngine.CoreModule" binding-path="expSpecialsFX" allow-scene-objects="false" class="normalObjectView" style="overflow: visible; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                        <uie:ObjectField label="Skybox" name="expSkybox" type="UnityEngine.Material, UnityEngine.CoreModule" binding-path="expSkybox" allow-scene-objects="false" class="normalObjectView" style="overflow: visible; -unity-font-definition: resource(&quot;Rubik-Regular&quot;);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="createSpace" style="position: relative; justify-content: flex-start; flex-grow: 1; display: none; border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px;">
            <ui:Label text="Create New Workspace" display-tooltip-when-elided="true" name="createLabel" style="-unity-text-align: middle-center; font-size: 30px; background-color: rgb(34, 34, 34); -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); padding-top: 5px; padding-bottom: 5px;"/>
            <ui:VisualElement name="Space" style="height: 142px; display: none;"/>
            <ui:VisualElement name="workspaceArea" style="flex-direction: column; background-color: rgb(51, 51, 51); margin-left: 50px; margin-right: 50px; margin-top: 10px; margin-bottom: 10px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
                <ui:VisualElement name="top" style="flex-direction: row;">
                    <ui:VisualElement name="icon" style="background-image: resource(&quot;containerIcon&quot;); width: 80px; height: 80px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(128, 33, 252); margin-left: 20px; margin-top: 10px; margin-bottom: 10px; margin-right: 20px;"/>
                    <ui:VisualElement name="inputFields" style="flex-grow: 1; justify-content: space-around; margin-right: 20px;">
                        <ui:TextField picking-mode="Ignore" label="Workspace Name" value="WorkspaceName" name="newSpaceName" style="-unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;FlatSkin/Font/Roboto-Regular&quot;); font-size: 14px; flex-direction: row; display: flex;"/>
                        <ui:TextField picking-mode="Ignore" label="Created By:" value="CreatorName" name="newSpaceAuthor" style="-unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;FlatSkin/Font/Roboto-Regular&quot;); font-size: 14px; flex-direction: row; display: flex;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="stageTypes" style="padding-top: 10px; padding-bottom: 5px; border-top-color: rgba(0, 0, 0, 0.3); border-top-width: 2px; padding-left: 20px; padding-right: 20px; flex-direction: row;">
                    <ui:Label text="Choose Stage Type(s) for this Workspace:" display-tooltip-when-elided="true" name="typesLabel" tooltip="Select all the Stage Type(s) you require for this Workspace. Each Stage Type selected will create the necessary framework (Prefabs, Scenes, etc) for the development of that kind of stage. [Hover over a Stage Type for more details]" style="-unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); font-size: 14px;"/>
                    <ui:Toggle name="normType" text="NORMAL" tooltip="A Normal (Linear) Stage is the default stage type for regular play. A series of 3 &quot;Stage Tiles&quot; moves towards the player like a conveyor belt, giving the impression of forward motion." class="normToggleType checkBoxFlex" style="overflow: visible; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); margin-top: 0; margin-bottom: 0;"/>
                    <ui:Toggle name="spinType" text="SPIN" tooltip="A Spin Stage is suitable for use with Spin Mode gameplay. To the player, the world remains fixed while animated objects move around the player. When the &quot;Spin Emitter&quot; object moves it changes the direction of gameplay which turns the player in their playspace." class="normToggleType checkBoxFlex" style="overflow: visible; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); margin-top: 0; margin-bottom: 0;"/>
                    <ui:Toggle name="expType" text="EXP" tooltip="Experience Stages are Stages with tailor-made visuals for a specific song. Using the UnityTimeline, you can animate visual elements to synchronize with the song." class="normToggleType checkBoxFlex" style="overflow: visible; -unity-text-align: middle-left; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); margin-top: 0; margin-bottom: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="types" style="display: none; padding-left: 50px; padding-right: 50px; padding-top: 10px; padding-bottom: 10px;">
                <ui:Label text="What Stage type(s)?" display-tooltip-when-elided="true" name="typesLabel" style="font-size: 20px; -unity-font-definition: resource(&quot;Rubik-Regular SDF&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); padding-bottom: 10px; padding-left: 5px;"/>
                <ui:VisualElement name="stageTypes" style="flex-direction: row; justify-content: space-around; padding-top: 10px; padding-bottom: 10px; border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px;">
                    <ui:Toggle label="Normal Stage" name="normStageCreate" style="font-size: 14px; -unity-font-definition: resource(&quot;Rubik-Regular SDF&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); -unity-text-align: middle-center;"/>
                    <ui:Toggle label="Spin Stage" name="spinStageCreate" style="-unity-text-align: middle-center; font-size: 14px; -unity-font-definition: resource(&quot;Rubik-Regular SDF&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;);"/>
                    <ui:Toggle label="Experience Stage" name="expStageCreate" style="-unity-text-align: upper-center; font-size: 14px; -unity-font-definition: resource(&quot;Rubik-Regular SDF&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="import" style="border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px; margin-left: 50px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-right: 50px; padding-left: 10px; padding-right: 10px; display: none;"/>
            <ui:Foldout text="Importing a Custom Stage" value="false" name="import" style="border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; margin-left: 50px; margin-right: 50px; -unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); font-size: 15px; -unity-text-align: middle-left; max-height: 400px;">
                <ui:ScrollView name="ScrollView" style="background-color: rgb(34, 34, 34); flex-grow: 1; margin-right: 14px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;">
                    <ui:Label text="Importing a Custom Stage allows you to add an existing Custom Stage (including legacy Stages) to this Project. " display-tooltip-when-elided="true" name="importMessage" style="white-space: normal; font-size: 12px; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; margin-right: 15px;"/>
                    <ui:Foldout text="For LEGACY Stage Import:" name="legacy" value="false" style="margin-left: 20px; -unity-font-definition: resource(&quot;Rubik-VariableFont_wght SDF&quot;); -unity-font-style: bold;">
                        <ui:Label text="&lt;size=170%&gt;• &lt;/size&gt;Please ensure you have the correct Stage Type(s) selected above to match the Project you are importing.&#10;&lt;size=170%&gt;• &lt;/size&gt;Your existing Scenes and previous CustomStageInfo prefab will not be migrated.&#10;&lt;size=170%&gt;• &lt;/size&gt;Workspace Manager will create new Scenes appropriate for each Stage Type selected and a new CustomStageInfo prefab.&#10;&lt;size=170%&gt;• &lt;/size&gt;After import, you will need to relink your Prefabs to the appropriate Scenes.  For example, for a Normal Stage with 3 Stage Tiles, you will have to drag and drop each Stage Tile prefab into the newly created Scene.&#10;&lt;size=170%&gt;• &lt;/size&gt;VRTK and DOTWeen folders will not be migrated, VRTK is deprecated (replaced by OpenXR).&#10;&lt;size=170%&gt;• &lt;/size&gt;The Legacy game-provided scripts in &quot;_CustomStageElements/Scripts&quot; are deprecated, please use the SR Stage Objects available in SR Toolkit instead." display-tooltip-when-elided="true" name="message" style="white-space: normal; font-size: 12px; -unity-text-align: upper-left; -unity-font-style: normal; flex-wrap: wrap; padding-left: 0; padding-right: 0; padding-bottom: 5px;"/>
                    </ui:Foldout>
                    <ui:Foldout text="For REMASTERED Stage Import:" name="remastered" value="false" style="margin-left: 20px; -unity-font-definition: resource(&quot;Rubik-VariableFont_wght SDF&quot;); -unity-font-style: bold;">
                        <ui:Label text="&lt;size=170%&gt;• &lt;/size&gt;Please ensure you have the correct Stage Type(s) selected above to match the Project you are importing.&#10;&lt;size=170%&gt;• &lt;/size&gt;Your existing Scenes will not be migrated.&#10;&lt;size=170%&gt;• &lt;/size&gt;Workspace Manager will create new Scenes appropriate for each Stage Type selected and import your CustomStageInfo prefab.&#10;&lt;size=170%&gt;• &lt;/size&gt;After import, you will need to relink your Prefabs to the appropriate Scenes.  For example, for a Normal Stage with 3 Stage Tiles, you will have to drag and drop each Stage Tile prefab into the newly created Scene." display-tooltip-when-elided="true" name="message" style="flex-wrap: wrap; white-space: normal; padding-bottom: 10px; font-size: 12px; -unity-font-style: normal;"/>
                    </ui:Foldout>
