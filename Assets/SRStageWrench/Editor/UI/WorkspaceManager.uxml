                            <ui:Label text="NORMAL" display-tooltip-when-elided="true" name="normal" style="-unity-font-definition: resource(&quot;Rubik-Regular&quot;); -unity-font: resource(&quot;Rubik-Regular&quot;); color: rgb(171, 106, 255); border-left-color: rgb(171, 106, 255); border-right-color: rgb(171, 106, 255); border-top-color: rgb(171, 106, 255); border-bottom-color: rgb(171, 106, 255); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; width: 50px; padding-left: 0; padding-right: 0; -unity-text-align: middle-center; font-size: 11px; margin-left: 3px; margin-right: 3px;"/>
